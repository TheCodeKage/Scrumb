###Create Team 1
POST {{host_url}}/users/team/
Authorization: Bearer {{token1}}
Content-Type: application/json

{
    "name": "Team Alpha"
}

> {%
    client.global.set("team_id1", response.body.id);
 %}


###Create Team 2
POST {{host_url}}/users/team/
Authorization: Bearer {{token1}}
Content-Type: application/json

{
    "name": "Team Beta"
}

> {%
    client.global.set("team_id2", response.body.id);
 %}

###Create Team 3
POST {{host_url}}/users/team/
Authorization: Bearer {{token1}}
Content-Type: application/json

{
    "name": "Team Gamma"
}

> {%
