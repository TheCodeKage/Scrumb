###Get all teams
GET {{host_url}}/users/team/?show_all=true
Authorization: Bearer {{token1}}

###Get team details 1
GET {{host_url}}/users/team/1/
Authorization: Bearer {{token1}}

> {%
    client.global.set("team_id1", response.body.id);
 %}


###Get team details 2
GET {{host_url}}/users/team/{{team_id2}}/
Authorization: Bearer {{token1}}


###Get team details 3
GET {{host_url}}/users/team/{{team_id3}}/
Authorization: Bearer {{token1}}


###Send team invitation 1
POST {{host_url}}/users/team/{{team_id1}}/invite/
Authorization: Bearer {{token1}}
Content-Type: application/json

{
    "username": "{{username2}}"
}

###Send team invitation 2
POST {{host_url}}/users/team/{{team_id2}}/invite/
Authorization: Bearer {{token1}}
Content-Type: application/json

{
    "username": "{{username2}}"
}